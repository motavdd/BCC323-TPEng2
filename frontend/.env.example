# Configuração de demonstração para Firebase local emulado (demo-bcc323).
# Para projeto remoto, use um arquivo local separado e VITE_USE_EMULATORS=false.
VITE_USE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_PROJECT_ID=demo-bcc323
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bcc323.firebaseapp.com
VITE_FIREBASE_APP_ID=1:123456789:web:demo
# Somente Vite (servidor): o navegador usa /api na mesma origem.
API_PROXY_TARGET=http://127.0.0.1:8081
