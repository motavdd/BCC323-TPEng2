rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName', 'course', 'courseId', 'period', 'createdAt'])
        && (!('courseId' in request.resource.data) || (request.resource.data.courseId is string && request.resource.data.courseId.size() > 0 && request.resource.data.courseId.size() <= 100))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.course is string
        && request.resource.data.course.size() > 0
        && request.resource.data.course.size() <= 100
        && request.resource.data.period is int
        && request.resource.data.period >= 1
        && request.resource.data.period <= 20;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'course', 'courseId', 'period']);
      allow delete: if false;

      match /completedCourses/{courseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['completedAt', 'subjectName'])
          && request.resource.data.completedAt is timestamp
          && (!('subjectName' in request.resource.data)
              || (request.resource.data.subjectName is string
                  && request.resource.data.subjectName.size() > 0
                  && request.resource.data.subjectName.size() <= 100));
        allow delete: if isOwner(userId);
      }

      match /plans/{planId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'next'
          && request.resource.data.keys().hasOnly(['offeringIds', 'updatedAt'])
          && request.resource.data.offeringIds is list
          && request.resource.data.offeringIds.size() <= 24
          && request.resource.data.offeringIds.toSet().hasOnly(['BCC202-A', 'BCC202-B'])
          && request.resource.data.offeringIds.toSet().size() == request.resource.data.offeringIds.size()
          && !(request.resource.data.offeringIds.hasAll(['BCC202-A', 'BCC202-B']))
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }

    match /academicCalendar/terms {
      allow get: if request.auth != null;
    }

    match /courses/{courseId} {
      allow get, list: if request.auth != null;
      allow write: if false;

      match /coordinators/{uid} {
        allow get: if isOwner(uid);
      }

      // Scheduled revisions are available only to the backend service identity.
    }

    // Fórum e grade: fechados até a modelagem de visibilidade/permissões.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
